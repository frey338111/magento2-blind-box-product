<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="order_items">
            <arguments>
                <argument name="columns" xsi:type="array">
                    <item name="blind_box_sku" xsi:type="string" translate="true">Blind box item</item>
                </argument>
            </arguments>
            <block class="Magento\Sales\Block\Adminhtml\Items\Column\DefaultColumn"
                   name="column_blind_box_sku"
                   template="Hmh_BlindBoxProduct::order/view/items/column/blind_box_sku.phtml"
                   group="column" />
        </referenceBlock>
        <referenceBlock name="default_order_items_renderer">
            <arguments>
                <argument name="columns" xsi:type="array">
                    <item name="blind_box_sku" xsi:type="string" translate="false">col-blind-box-sku</item>
                </argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
