<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Checkout\Model\AddProductToCart">
        <plugin name="hmh_blindbox_add_product_to_cart_before"
                type="Hmh\BlindBoxProduct\Plugin\Checkout\AddProductToCartPlugin" />
    </type>
    <type name="Magento\Checkout\Block\Cart\Item\Renderer">
        <plugin name="hmh_blindbox_cart_item"
                type="Hmh\BlindBoxProduct\Plugin\Checkout\CartItemPlugin" />
    </type>
    <type name="Magento\Checkout\CustomerData\ItemPool">
        <arguments>
            <argument name="defaultItemId" xsi:type="string">Hmh\BlindBoxProduct\CustomerData\DefaultItem</argument>
        </arguments>
    </type>
    <type name="Magento\Checkout\Model\DefaultConfigProvider">
        <plugin name="hmh_blindbox_checkout_summary_item"
                type="Hmh\BlindBoxProduct\Plugin\Checkout\CheckoutSummaryItemPlugin" />
    </type>

    <type name="Magento\Sales\Block\Order\Item\Renderer\DefaultRenderer">
        <plugin name="hmh_blindbox_order_item_renderer"
                type="Hmh\BlindBoxProduct\Plugin\Sales\OrderItemRendererPlugin" />
    </type>
</config>
